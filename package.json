  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
